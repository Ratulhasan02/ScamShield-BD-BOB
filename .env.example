# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/scamshield?retryWrites=true&w=majority&appName=ScamShield-BD

# MongoDB database name
MONGODB_DB=scamshield

# Secret used to sign admin JWTs - change this to a long random string
JWT_SECRET=change-this-to-a-long-random-secret

# Optional: if set, AI-assisted analysis (Anthropic Claude) is used.
# If left empty, ScamShield BD automatically falls back to its built-in
# deterministic rule-based analysis engine so the app still works fully.
ANTHROPIC_API_KEY=

# Public site URL (used for share links / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default admin bootstrap credentials
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-this-password